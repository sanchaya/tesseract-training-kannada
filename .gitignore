# ── Node.js ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.env
.env.*

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
*.egg
pip-wheel-metadata/

# ── Generated training data (large; reproducible) ──────────────────
rendered/
lstmf/
output/
best/
scan-input/

# tessdata — downloaded at runtime via 01-prep-base.sh
tessdata_best/*.traineddata
# configs symlink set up by 02-make-lstmf.sh
tessdata_best/configs

# ── Fonts (cloned/downloaded at runtime by 01-prep-base.sh) ────────
# git-cloned font repos — fetched fresh, not submodules
fonts/kan_*/
# binary font files
fonts/*.ttf
fonts/*.otf
fonts/**/*.ttf
fonts/**/*.otf

# ── Corpus cache (large downloaded files, regenerated at runtime) ───
corpus/cache/
# raw text extracted from Wikipedia dump
corpus/raw_kannada.txt

# ── Logs ───────────────────────────────────────────────────────────
logs/
*.log
training.log

# ── Private / internal documents ───────────────────────────────────
_private/

# ── OS / editor ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
.Spotlight-V100
.Trashes
.idea/
.vscode/
*.swp
*.swo
*~

# ── Docker (runtime state) ─────────────────────────────────────────
.docker/

# ── Corpus (downloaded at runtime; build_corpus.py regenerates) ────
corpus/kan_corpus.txt

# ── Test artefacts (generated by scripts/gen-char-images.py) ──────
# Re-generate with: python3 scripts/gen-char-images.py
test-images/**/*.png
test-images/**/*.tif
test-images/**/*.jpg
test-images/**/*.gt.txt
test-images/**/manifest.json
test-images/manifest.json
