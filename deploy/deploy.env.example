# Copy to deploy/deploy.env and fill in. deploy.env is gitignored.

# SSH target. The user needs passwordless sudo on the server
# (rsync and systemctl run through sudo).
DEPLOY_HOST=ubuntu@trainocr.sanchaya.net
# Extra ssh options, e.g. "-p 2222 -i ~/.ssh/trainocr"
SSH_OPTS=""

# Public hostname nginx answers for.
DOMAIN=trainocr.sanchaya.net

# Where the app lives on the server, and the unprivileged user it runs as.
APP_DIR=/opt/trainocr
APP_USER=trainocr

# Node listens on 127.0.0.1:PORT — only nginx can reach it.
PORT=3000

# The portal can start training jobs and delete data, and has no login of
# its own, so nginx puts HTTP basic auth in front of it. Leave empty to
# serve it openly (not recommended on a public host).
BASIC_AUTH_USER=sanchaya

# Let's Encrypt. Needs DNS for DOMAIN pointing at the server first.
ENABLE_TLS=yes
CERTBOT_EMAIL=you@example.org
